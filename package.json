{
  "name": "dossier-research-mcp",
  "version": "0.1.0",
  "description": "Dossier \u2014 Google Gemini Deep Research as an MCP server. Durable background runs, spend control, context-safe report reading, citation verification, and private-corpus grounding.",
  "type": "module",
  "license": "MIT",
  "author": "fledgeling-co",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fledgeling-co/dossier-research-mcp.git"
  },
  "homepage": "https://github.com/fledgeling-co/dossier-research-mcp#readme",
  "bugs": {
    "url": "https://github.com/fledgeling-co/dossier-research-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "gemini",
    "deep-research",
    "fastmcp",
    "ai",
    "research",
    "claude",
    "dossier"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "bin": {
    "dossier": "dist/index.js",
    "dossier-research-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "assets/icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsgo -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest",
    "inspect": "npm run build && npx fastmcp inspect dist/index.js",
    "gate": "npm run typecheck && npm run lint && npm run test:all && npm run build",
    "prepublishOnly": "npm run build",
    "lint": "eslint .",
    "preversion": "npm run gate",
    "version": "node scripts/sync-version.mjs && git add src/version.ts",
    "postversion": "git push --follow-tags",
    "test:acceptance": "vitest run --project acceptance",
    "test:all": "vitest run --project unit --project acceptance",
    "test:paid": "vitest run --project paid"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.24",
    "@google/genai": "^2.13.0",
    "ai": "^7.0.37",
    "fastmcp": "^4.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@swc/core": "^1.15.46",
    "@types/node": "^26.1.1",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "eslint": "^10.8.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0",
    "typescript-eslint": "^8.65.0",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@hono/node-server": "^2.0.5"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
