# ─── Auth: pick ONE backend ──────────────────────────────────────────────────
# (A) Google AI Studio / Gemini API key. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# (B) Vertex AI. Set VERTEX_PROJECT + VERTEX_LOCATION and authenticate with ADC
#     (`gcloud auth application-default login`) or GOOGLE_APPLICATION_CREDENTIALS.
#     When VERTEX_PROJECT is set it takes precedence over GEMINI_API_KEY.
VERTEX_PROJECT=
VERTEX_LOCATION=global
# GOOGLE_APPLICATION_CREDENTIALS=/abs/path/to/service-account.json

# ─── Other backends: presence enables, nothing else required ─────────────────
# Each one adds something Gemini has none of. See docs/providers/.
# Perplexity: enforced date and domain filters, and native wide research.
PERPLEXITY_API_KEY=
# OpenAI: a 100-domain filter, the largest on offer.
OPENAI_API_KEY=
# xAI: the only backend that reaches X.
XAI_API_KEY=

# Explicit allow-list, comma separated. Overrides detection: a key present for
# some other tool should not silently become a place Dossier can spend money.
# Also the only way to let the `local` CLI backend be chosen automatically.
# DOSSIER_PROVIDERS=gemini,perplexity

# ─── The free tiers ──────────────────────────────────────────────────────────
# Which coding CLI backs `provider: "local"`: claude, codex, agy, cursor, grok
# or gemini. Omit to auto-detect in that order. `research_doctor` shows what is
# installed, identified and signed in. Never chosen automatically: it costs $0,
# so a cost tie-break would pick it every time, over a subscription quota
# Dossier cannot meter.
# DOSSIER_LOCAL_CLI=claude

# Absolute directories `corpus_local_search` may read, colon or comma
# separated. Files are read and matched on this machine and never sent
# anywhere. There is deliberately no tool that adds one: a file reader an agent
# can point anywhere is an exfiltration primitive, so the grant lives with you.
# DOSSIER_LOCAL_CORPUS_DIRS=/Users/you/notes:/Users/you/research

# ─── Storage ─────────────────────────────────────────────────────────────────
# Where runs, journals, reports and the spend ledger are persisted.
# Default: ~/.dossier-research-mcp
DOSSIER_STORE_DIR=

# ─── Spend control ───────────────────────────────────────────────────────────
# Hard ceiling in USD per rolling window (the daily spend cap). A run that would cross it is refused.
# Set to 0 to disable the gate (not recommended for agent-driven callers).
DOSSIER_BUDGET_USD=100
# Rolling window for the budget, in hours.
DOSSIER_BUDGET_WINDOW_HOURS=24

# Optional per-provider sub-ceilings inside the global one. 0 means only the
# global ceiling applies. Evaluated under the same lock, so one backend cannot
# quietly consume the lot.
# DOSSIER_BUDGET_USD_GEMINI=
# DOSSIER_BUDGET_USD_PERPLEXITY=
# DOSSIER_BUDGET_USD_OPENAI=
# DOSSIER_BUDGET_USD_XAI=
# Max runs in flight at once.
DOSSIER_MAX_CONCURRENT=10
# Require research_plan → research_start (a run cannot be started from a bare
# question). Turns a runaway agent loop into cheap no-ops. Default: false.
DOSSIER_REQUIRE_CONTRACT=false
# TTL in minutes for de-duplicating identical requests onto one run.
DOSSIER_DEDUPE_TTL_MINUTES=1440

# ─── Runtime ─────────────────────────────────────────────────────────────────
# Poll interval (seconds) for advancing in-flight runs.
DOSSIER_POLL_SECONDS=20
# Mark a run `stalled` after this many minutes with no progress.
DOSSIER_STALL_MINUTES=12
# Model used for cheap side-work (titles, summaries, follow-up Q&A, claim cards).
DOSSIER_UTILITY_MODEL=gemini-3.1-pro-preview

# ─── Transport (only for `--transport http`) ─────────────────────────────────
DOSSIER_HTTP_PORT=8787
# Comma-separated bearer tokens accepted on the HTTP transport. Required when
# binding to anything other than loopback.
# Comma-separated bearer tokens. MINIMUM 24 CHARACTERS: this guards a surface
# that spends money, and comparing a short token in constant time does not make
# it harder to guess. Generate one with `openssl rand -base64 32`.
DOSSIER_HTTP_TOKENS=

# Required to start an HTTP listener with no tokens at all. Without it the
# server exits rather than serving a money-spending tool surface to anything
# that can reach the port.
# DOSSIER_HTTP_ALLOW_ANONYMOUS=false

# ─── Test-only ───────────────────────────────────────────────────────────────
# Set to 1 to make the server refuse to construct a live Gemini client at all,
# so a stray key in the environment cannot reach the network. vitest.config.ts
# sets this for the whole suite; you should not need it by hand.
# DOSSIER_HERMETIC=
