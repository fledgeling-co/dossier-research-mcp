# ─── Auth: pick ONE backend ──────────────────────────────────────────────────
# (A) Google AI Studio / Gemini API key. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# (B) Vertex AI. Set VERTEX_PROJECT + VERTEX_LOCATION and authenticate with ADC
#     (`gcloud auth application-default login`) or GOOGLE_APPLICATION_CREDENTIALS.
#     When VERTEX_PROJECT is set it takes precedence over GEMINI_API_KEY.
VERTEX_PROJECT=
VERTEX_LOCATION=global
# GOOGLE_APPLICATION_CREDENTIALS=/abs/path/to/service-account.json

# ─── Storage ─────────────────────────────────────────────────────────────────
# Where runs, journals, reports and the spend ledger are persisted.
# Default: ~/.dossier-research-mcp
DOSSIER_STORE_DIR=

# ─── Spend control ───────────────────────────────────────────────────────────
# Hard ceiling in USD per rolling window (the daily spend cap). A run that would cross it is refused.
# Set to 0 to disable the gate (not recommended for agent-driven callers).
DOSSIER_BUDGET_USD=100
# Rolling window for the budget, in hours.
DOSSIER_BUDGET_WINDOW_HOURS=24
# Max runs in flight at once.
DOSSIER_MAX_CONCURRENT=10
# Require research_plan → research_start (a run cannot be started from a bare
# question). Turns a runaway agent loop into cheap no-ops. Default: false.
DOSSIER_REQUIRE_CONTRACT=false
# TTL in minutes for de-duplicating identical requests onto one run.
DOSSIER_DEDUPE_TTL_MINUTES=1440

# ─── Runtime ─────────────────────────────────────────────────────────────────
# Poll interval (seconds) for advancing in-flight runs.
DOSSIER_POLL_SECONDS=20
# Mark a run `stalled` after this many minutes with no progress.
DOSSIER_STALL_MINUTES=12
# Model used for cheap side-work (titles, summaries, follow-up Q&A, claim cards).
DOSSIER_UTILITY_MODEL=gemini-3.1-pro-preview

# ─── Transport (only for `--transport http`) ─────────────────────────────────
DOSSIER_HTTP_PORT=8787
# Comma-separated bearer tokens accepted on the HTTP transport. Required when
# binding to anything other than loopback.
DOSSIER_HTTP_TOKENS=

# ─── Test-only ───────────────────────────────────────────────────────────────
# Set to 1 to make the server refuse to construct a live Gemini client at all,
# so a stray key in the environment cannot reach the network. vitest.config.ts
# sets this for the whole suite; you should not need it by hand.
# DOSSIER_HERMETIC=
